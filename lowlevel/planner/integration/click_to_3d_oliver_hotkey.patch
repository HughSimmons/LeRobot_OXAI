+    def plan_pick_at_click(self) -> None:
+        """d: k's two clicks, but planned by planner.click_bridge (dls_nullspace) and run in-process."""
+        if self.prev_result is None or self.last_result is None:
+            self.status = "click the piece, then its destination square, then d"
+            return
+        if self.mode not in ("live", "ready"):
+            self.status = "finish the current step before picking (d)"
+            return
+        try:
+            from click3d_shared import _ensure_lowlevel_on_path
+
+            _ensure_lowlevel_on_path()  # puts LeRobot_OXAI/lowlevel on sys.path, where planner/ lives
+            from planner.click_bridge import pick_piece_planned
+        except ImportError as exc:
+            self.status = f"d needs lowlevel/planner (find_piece branch) and its deps: {exc}"
+            print(self.status)
+            return
+        piece, square, robot = self.prev_result, self.last_result, self.args.robot
+        compensate, baseline = self.args.compensate, self.args.baseline
+        self.run_in_background(
+            "PLANNED_PICK",
+            lambda on_move: pick_piece_planned(
+                piece, square, compensate=compensate, baseline=baseline, robot=robot, on_move=on_move
+            ),
+        )
+
 
 
